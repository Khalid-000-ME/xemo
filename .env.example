# ─── Platform ────────────────────────────────────────────────────────────────
# Must be the public origin once deployed: generated apps and x402 payment
# requirements are built from it, so localhost here means localhost there.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=./data/agentfoundry.db

# ─── Agent model ─────────────────────────────────────────────────────────────
# Without this the planner falls back to a deterministic spec and fulfilment
# returns the spec's sample output, both clearly labelled in the UI.
ANTHROPIC_API_KEY=
AGENTFOUNDRY_MODEL=claude-sonnet-5-5

# ─── CreateOS Sandbox ────────────────────────────────────────────────────────
# Generate from https://createos.sh/app/profile, or let Stripe Projects create
# the account for you:  stripe projects add createos/project
CREATEOS_SANDBOX_API_KEY=
CREATEOS_SHAPE=s-1vcpu-1gb
# Alpine is the catalog default; devbox:1 is the one with a Node toolchain.
CREATEOS_ROOTFS=devbox:1
# Free plan runs ONE concurrent sandbox and paused boxes still count. Raise this
# to your plan's cap (Beginner 5, Pro 20) or builds will reclaim each other.
CREATEOS_MAX_CONCURRENT_SANDBOXES=1
CREATEOS_AUTO_PAUSE_SECONDS=900

# ─── Stripe (human rail) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Without this the webhook refuses the payload rather than trusting it.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PROJECT_ID=

# ─── x402 (agent rail) ───────────────────────────────────────────────────────
# eip155:84532 = Base Sepolia (testnet). eip155:8453 = Base mainnet.
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# The address payments settle to. Until this is set the x402 routes answer 503
# rather than advertising a priced resource with nowhere to pay.
X402_PAY_TO=
# What an agent pays AppFactory to commission one build.
X402_COMMISSION_PRICE_USD=0.50
# What an agent pays per call to any app AppFactory generated.
X402_GENERATED_APP_PRICE_USD=0.02
X402_SERVICE_NAME=AppFactory
X402_ICON_URL=

# ─── PayBox (agent spend) ────────────────────────────────────────────────────
# A pbx_live_* key from the Clients screen. Without it supplier spend is still
# recorded, but marked unsettled rather than passed off as paid.
PAYBOX_API_KEY=
PAYBOX_API_URL=https://api.paybox.sh
PAYBOX_MCP_URL=https://api.paybox.sh/mcp
PAYBOX_CREDENTIAL_ID=
PAYBOX_MAX_SPEND_PER_BUILD_USD=0.25

# ─── Limits ──────────────────────────────────────────────────────────────────
LIMIT_MAX_PROMPT_CHARS=2000
LIMIT_MIN_PRICE_USD=1
LIMIT_MAX_PRICE_USD=100
LIMIT_BUILD_TIMEOUT_MS=600000
